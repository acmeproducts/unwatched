# Pick one brain. Leave both unset to run on the free mock brain.

# --brain openrouter  (your own key; same prompts, sent through OpenRouter)
OPENROUTER_API_KEY=
FT_OR_MODEL_ROUTINE=anthropic/claude-haiku-4.5
FT_OR_MODEL_STAKES=anthropic/claude-sonnet-5
FT_OR_MODEL_REFLECT=anthropic/claude-opus-5

# --brain anthropic  (direct)
ANTHROPIC_API_KEY=
FT_MODEL_ROUTINE=claude-haiku-4-5
FT_MODEL_STAKES=claude-sonnet-5
FT_MODEL_REFLECT=claude-opus-5
