# Pick one brain. Leave both unset to run on the free mock brain.

# --brain openrouter  (your own key; same prompts, sent through OpenRouter)
OPENROUTER_API_KEY=
FT_OR_MODEL_ROUTINE=anthropic/claude-haiku-4.5
FT_OR_MODEL_STAKES=anthropic/claude-sonnet-5
FT_OR_MODEL_REFLECT=anthropic/claude-opus-5

# --brain anthropic  (direct)
ANTHROPIC_API_KEY=
FT_MODEL_ROUTINE=claude-haiku-4-5
FT_MODEL_STAKES=claude-sonnet-5
FT_MODEL_REFLECT=claude-opus-5

# Server
PORT=4000
FT_BRAIN=mock              # mock | openrouter | anthropic
FT_MS_PER_SIM_MINUTE=1000  # 60000 is real time
FT_CITIZENS=20
FT_SEED=42

# Supabase (server writes with the service role; the web app uses the publishable key)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # Dashboard → Settings → API. Only the server needs it; never ship it to a browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000
FT_DEV_OWNER=0   # 1 lets a plain name sign in, for local development only
NEXT_PUBLIC_DEV_OWNER=0

# Stripe (optional). Without these the server runs billing in test mode: packs and plans apply with no charge.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_RESIDENT=
STRIPE_PRICE_PATRON=

# Ops room. Anyone with this token can pause the island; keep it out of browsers you do not own.
FT_OPS_TOKEN=
FT_DAILY_CEILING_USD=120

# Which island this server runs. Use a different id locally so a dev server never shares a record with the deployed town.
FT_TOWN_ID=island

# Music. Optional: an AI Studio key with Lyria RealTime access; scripts/gen-music.mjs writes a bed per scene into apps/web/public/sound.
GEMINI_API_KEY=

# Islands that connect. Other islands a ferry runs to, as id=engine-url pairs, and the secret every linked island shares.
# A citizen who leaves for one arrives there with their coins, things and memories; the news from home crosses with them.
FT_TOWN_NAME=The island
FT_HARBORS=
FT_FERRY_SECRET=

# The island keeps our time. Set to hvar, vis or korcula: the weather is that island's live weather from Open-Meteo (no key),
# the seasons are the calendar's, the clock is that island's clock, dawn and dusk are its sunrise and sunset, and the ferry keeps a seasonal timetable.
FT_REAL_WORLD=hvar
